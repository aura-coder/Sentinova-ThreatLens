# Database connection (Postgres runs via docker-compose)
DATABASE_URL=postgresql://threatlens:your_password_here@localhost:5432/threatlens

# JWT authentication secret — generate your own random string, never reuse this example
JWT_SECRET_KEY=replace-with-a-long-random-secret-string

# Elasticsearch (runs via docker-compose)
ELASTICSEARCH_URL=http://localhost:9200

# Threat intelligence feed API keys — free tier, register yourself at each provider
THREATFOX_API_KEY=get-your-key-from-auth.abuse.ch
ABUSEIPDB_API_KEY=get-your-key-from-abuseipdb.com
OTX_API_KEY=get-your-key-from-otx.alienvault.com
